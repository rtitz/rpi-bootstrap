#!/bin/bash
# Generated by Ansible - Manual changes will be overwritten

REPOS=(
{% for app in monitored_containers %}
    "{{ container_user_home }}/{{ app.name }}:{{ app.branch }}:{{ app.name }}"
{% endfor %}
)

# Dynamically set the explicit systemd bus pointer matching this user account
export XDG_RUNTIME_DIR="/run/user/{{ container_uid }}"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/{{ container_uid }}/bus"

# --- Image Prune Logic (Stored in /tmp) ---
# Uniquely name the file using the container UID so multiple rootless accounts don't conflict
TRACK_FILE="/tmp/podman_prune_{{ container_uid }}_timestamp"

# If the tracking file doesn't exist, or is older than 1440 minutes (24 hours), run the prune
if [ ! -f "$TRACK_FILE" ] || ! find "$TRACK_FILE" -mmin -1440 | grep -q .; then
    echo "[$(date)] Running scheduled global image prune..."
    podman image prune -a -f
    touch "$TRACK_FILE"
fi

for ENTRY in "${REPOS[@]}"; do
    REPO_DIR="${ENTRY%%:*}"
    REST="${ENTRY#*:}"
    BRANCH="${REST%%:*}"
    APP_NAME="${REST##*:}"

    echo "Update $APP_NAME ..." 
    if [ ! -d "$REPO_DIR" ]; then
        continue
    fi

    cd "$REPO_DIR" || continue

    git fetch origin "$BRANCH" >/dev/null 2>&1
    LOCAL=$(git rev-parse HEAD)
    REMOTE=$(git rev-parse @{u})

    if [ "$LOCAL" != "$REMOTE" ]; then
        echo "[$(date)] Background update detected in $APP_NAME. Recycling service..."
        # Systemd's ExecStartPre in the app service will handle the fresh git pull and rebuild automatically!
        systemctl --user restart "container-${APP_NAME}.service"
    fi
done
