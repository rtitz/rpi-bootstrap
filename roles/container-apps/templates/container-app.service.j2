[Unit]
Description=Systemd wrapper for {{ item.name }} container stack
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory={{ container_user_home }}
Restart=always

# Route background hooks straight to your persistent unprivileged runtime sockets
Environment="XDG_RUNTIME_DIR=/run/user/{{ container_uid }}"

# 1. Self-healing Git deployment layout
ExecStartPre=/bin/bash -c '\
  if [ ! -d "{{ item.name }}" ]; then \
    git clone -b {{ item.branch }} {{ item.repo_url }} {{ item.name }}; \
  else \
    cd {{ item.name }} && git fetch origin {{ item.branch }} && git reset --hard origin/{{ item.branch }}; \
  fi'

# 2. Step into the freshly updated repo folder and initialize the attached stack natively
ExecStart=/bin/bash -c 'cd {{ item.name }} && /usr/bin/podman compose up --build'

# 3. Step into the repo folder to securely pull down your application nodes on termination
ExecStop=/bin/bash -c 'cd {{ item.name }} && /usr/bin/podman compose down'

[Install]
WantedBy=default.target
