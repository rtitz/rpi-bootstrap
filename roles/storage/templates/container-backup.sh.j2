#!/usr/bin/env bash
set -euo pipefail

# Define paths dynamically from Ansible variables
STORAGE_PATH="{{ storage_mount_path }}"
KEEP_COUNT="{{ backup_keep_count | default(14) }}"
TIMESTAMP=$(/usr/bin/date +%Y%m%d-%H%M%S)

BACKUP_DIR="${STORAGE_PATH}/backup"
MIRROR_DIR="${BACKUP_DIR}/latest_mirror"
FINAL_FILENAME="${TIMESTAMP}_home.tar.gz"

# Create backup and mirror directories if they are missing
/usr/bin/mkdir -p "${BACKUP_DIR}"
/usr/bin/mkdir -p "${MIRROR_DIR}"

# ==========================================
# STEP 1: Live Directory Mirror (rsync)
# ==========================================
/usr/bin/rsync -aHAX --delete "${STORAGE_PATH}/home/" "${MIRROR_DIR}/"

# ==========================================
# STEP 2: Compressed Archive (tar.gz)
# ==========================================
# Run backup to a temporary file first for atomic safety
/usr/bin/tar --acls --xattrs -czf "${BACKUP_DIR}/TMP_home.tar.gz" -C "${STORAGE_PATH}" home

# Atomically move the completed backup to its final timestamped name
/usr/bin/mv "${BACKUP_DIR}/TMP_home.tar.gz" "${BACKUP_DIR}/${FINAL_FILENAME}"

# Safely change into the backup folder to link relatively
cd "${BACKUP_DIR}" || exit 1
/usr/bin/rm -f "latest_home.tar.gz"
/usr/bin/ln -s "${FINAL_FILENAME}" "latest_home.tar.gz"

# ==========================================
# STEP 3: Cleanup Retention
# ==========================================
/usr/bin/rm -f "TMP_home.tar.gz"
/usr/bin/find "." -maxdepth 1 -name "*_home.tar.gz" -print0 | xargs -0 ls -1tr 2>/dev/null | /usr/bin/head -n -"${KEEP_COUNT}" | /usr/bin/xargs -r rm
